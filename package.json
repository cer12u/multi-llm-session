{
  "name": "multi-llm-session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "tsx apps/cli/dev.ts",
    "start": "node dist/apps/core/main.js",
    "worker": "node dist/apps/agent-worker/main.js",
    "lab": "node dist/apps/cli/lab.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
