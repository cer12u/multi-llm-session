    "test:e2e": "playwright test",
    "dev": "tsx apps/cli/dev.ts",
    "start": "node dist/apps/core/main.js",
    "worker": "node dist/apps/agent-worker/main.js",
    "lab": "node dist/apps/cli/lab.js",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
