{
  "name": "multi-llm-session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.20.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
